# ============================================================================
# SENTRIX Production Environment Configuration Template
# ============================================================================
# Copy this file to .env and configure all variables prior to deployment.
# NEVER commit the active .env file containing production secrets to git.

# Deployment Environment ('production' enforces strict credential validation)
SENTRIX_ENV=production
APP_ENV=production

# Server Binding
HOST=0.0.0.0
PORT=8000
SENTRIX_SERVE_STATIC=1

# Database Configuration (PostgreSQL recommended for production, or SQLite volume)
DATABASE_URL=sqlite:////app/data/cyber_threats.db

# Cryptographic Authentication Secret
# REQUIRED in production. Must be at least 32 characters of high-entropy random data.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-minimum-32-char-random-production-secret-token

# Initial Administrative & Analyst Credentials
# REQUIRED in production. Passwords used to seed baseline accounts upon first database boot.
ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-initial-password-2026!
ANALYST_INITIAL_PASSWORD=replace-with-strong-analyst-initial-password-2026!

# Dedicated Telemetry Sensor Ingestion API Key
# REQUIRED for sensor telemetry submission (/api/v1/events, /api/v1/ingest/raw, /api/v1/analyze).
# Must be at least 32 characters of high-entropy key material.
# Sensors and log forwarders must supply this key in the 'X-SENTRIX-SENSOR-KEY' HTTP header.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTRIX_SENSOR_API_KEY=replace-with-at-least-32-char-random-sensor-api-key

# Enterprise Protected Subnets (CIDR format, comma-separated)
# Optional: IP ranges containing internal management servers, DNS root servers, or DB clusters.
# SENTRIX containment engine will refuse to contain any target within these networks.
# SENTRIX_PROTECTED_CIDRS=10.0.0.0/24,192.168.1.0/24

# External Threat Intelligence API (Optional)
# ABUSEIPDB_API_KEY=
